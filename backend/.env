APP_NAME=hyperdrive-backend
API_PREFIX=/api

# Database (Docker Postgres default)
DB_URL=postgresql+asyncpg://hyperdrive:hyperdrive@db:5432/hyperdrive
DB_USER=hyperdrive
DB_PASSWORD=hyperdrive
DB_NAME=hyperdrive

# If running locally without Docker, you can use SQLite:
# DB_URL=sqlite+aiosqlite:///./dev.db

# CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Algorand Indexer & Algod (fill with your providers)
ALGOD_URL=
ALGOD_TOKEN=
INDEXER_URL=
INDEXER_TOKEN=
NETWORK=testnet # or testnet/betanet
